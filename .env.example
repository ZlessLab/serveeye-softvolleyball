# ============================================================
#  ServeEye / Zless 環境変数テンプレート
#  このファイルをコピーして .env を作成し、値を入力してください。
#  .env は .gitignore に追加済み — 絶対にコミットしないこと。
#  Vercel にはダッシュボードの Environment Variables から登録する。
# ============================================================

# ── Stripe ──────────────────────────────────────────────────
# ライブキー（本番）または テストキー（開発） を使い分ける
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# リリース記念 個人ライセンス（1,980円）
STRIPE_PRODUCT_LAUNCH_INDIVIDUAL=prod_xxxxxxxxxxxx
STRIPE_PRICE_LAUNCH_INDIVIDUAL=price_xxxxxxxxxxxx

# 通常 個人ライセンス（2,980円）
STRIPE_PRODUCT_STANDARD_INDIVIDUAL=prod_xxxxxxxxxxxx
STRIPE_PRICE_STANDARD_INDIVIDUAL=price_xxxxxxxxxxxx

# チームライセンス（将来用）
STRIPE_PRODUCT_TEAM=prod_xxxxxxxxxxxx
STRIPE_PRICE_TEAM=price_xxxxxxxxxxxx

# 大会ライセンス（将来用）
STRIPE_PRODUCT_TOURNAMENT=prod_xxxxxxxxxxxx
STRIPE_PRICE_TOURNAMENT=price_xxxxxxxxxxxx

# Zless Sports Suite（将来用）
STRIPE_PRODUCT_SUITE=prod_xxxxxxxxxxxx
STRIPE_PRICE_SUITE=price_xxxxxxxxxxxx

# ── アクティブプラン ─────────────────────────────────────────
# 先着100本が売れたら standard_individual に変更して Vercel Redeploy するだけ
# launch_individual | standard_individual
ACTIVE_PLAN_ID=launch_individual

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend（メール送信）──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@zless.jp
RESEND_FROM_NAME=ServeEye

# ── アプリ設定 ────────────────────────────────────────────────
APP_BASE_URL=https://zless.jp
SUPPORT_EMAIL=support@zless.jp
