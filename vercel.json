{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/serveeye", "destination": "/soft-volleyball-score.html" }
  ],
  "headers": [
    {
      "source": "/(soft-volleyball-score.html|index.html|purchase-complete.html|manifest.json|sw.js|apple-touch-icon.png|favicon.png|icon-192.png|icon-512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/legal/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/icons-generated/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
