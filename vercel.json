{
  "version": 2,
  "builds": [
    { "src": "api/checkout/session.js",    "use": "@vercel/node" },
    { "src": "api/campaign/status.js",     "use": "@vercel/node" },
    { "src": "index.html",                 "use": "@vercel/static" },
    { "src": "soft-volleyball-score.html", "use": "@vercel/static" },
    { "src": "purchase-complete.html",     "use": "@vercel/static" },
    { "src": "legal/*.html",               "use": "@vercel/static" },
    { "src": "*.png",                      "use": "@vercel/static" },
    { "src": "icons-generated/*.png",      "use": "@vercel/static" },
    { "src": "manifest.json",              "use": "@vercel/static" },
    { "src": "sw.js",                      "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/serveeye", "dest": "/soft-volleyball-score.html" },
    { "src": "/",         "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(soft-volleyball-score.html|index.html|purchase-complete.html|manifest.json|sw.js|apple-touch-icon.png|favicon.png|icon-192.png|icon-512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/legal/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/icons-generated/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
